Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"$Assumptions", "=", " ", 
     RowBox[{
      RowBox[{"\[CapitalDelta]k", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"k", ">", "0"}], " ", "&&", " ", 
      RowBox[{"\[Tau]", "\[Element]", "Reals"}], " ", "&&", 
      RowBox[{"\[Tau]Q", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"d", "[", 
      RowBox[{"s_", ",", "z_"}], "]"}], " ", ":=", " ", 
     RowBox[{"ParabolicCylinderD", "[", 
      RowBox[{"s", ",", "z"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z", " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "\[CapitalDelta]k", "]"}], " ", "*", " ", "\[Tau]",
       " ", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", "*", 
        RowBox[{"Pi", "/", "4"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "I", "*", "\[CapitalDelta]k"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vk", " ", "=", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "s"}], "-", "1"}], ",", 
           RowBox[{
            RowBox[{"-", " ", "I"}], "  ", "z"}]}], "]"}]}], "+", " ", 
        RowBox[{"b", " ", "*", 
         RowBox[{"d", " ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "s"}], "-", "1"}], ",", " ", 
           RowBox[{"I", " ", "z"}]}], "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"uk", " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[CapitalDelta]k"}], " ", "\[Tau]", " ", "vk"}], "+", 
       " ", 
       RowBox[{"2", " ", "I", " ", 
        RowBox[{"D", "[", 
         RowBox[{"vk", ",", "\[Tau]"}], "]"}]}]}], " ", ")"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", " ", 
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox["\[Pi]", 
          RowBox[{"16", " ", "\[CapitalDelta]k"}]]}]], 
       RowBox[{"2", " ", 
        SqrtBox["\[CapitalDelta]k"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalDelta]k", " ", "=", " ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"4", "*", "\[Tau]Q", " ", 
         RowBox[{
          RowBox[{"Sin", "[", "k", "]"}], "^", "2"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]", " ", "=", " ", 
      RowBox[{"4", "*", "\[Tau]Q", " ", "*", " ", 
       RowBox[{"Sin", "[", "k", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "t"}], "/", "\[Tau]Q"}], "+", 
         RowBox[{"Cos", "[", "k", "]"}]}], ")"}]}]}], ";"}], " ", 
    "*)"}]}]}]], "Input",
