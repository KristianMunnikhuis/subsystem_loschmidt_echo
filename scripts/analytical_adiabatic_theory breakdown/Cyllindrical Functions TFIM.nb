Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Now", " ", "we", " ", "show", " ", "that", " ", "the", " ", "condition",
       " ", "vk", 
      RowBox[{"(", 
       RowBox[{"-", "inf"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
        "0", " ", "gives", " ", "a", " ", "and", " ", "b", " ", "\[IndentingNewLine]",
          "We", " ", "do", " ", "that", " ", "first", " ", "by", " ", 
         "showing", " ", "that", " ", "a", " ", "needs", " ", "to", " ", "be",
          " ", "0", " ", "\[IndentingNewLine]", "We", " ", "plot"}], " ", "|",
         "vk", "|", 
        RowBox[{
         RowBox[{"^", "2"}], " ", "in", " ", "the", " ", "asymptotic", " ", 
         "limit", " ", "that", " ", "tau"}]}], "->", 
       RowBox[{
        RowBox[{"-", "inf"}], " ", "for", " ", "b"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"0", " ", "and", " ", "a"}], "=", " ", 
       RowBox[{
        RowBox[{
        "0", " ", "respectively", "\[IndentingNewLine]", "We", " ", "first", " ",
          "see", " ", "that", " ", "a", " ", "asymptotes", " ", "for", " ", 
         "a", " ", "nonzero", " ", "constant", " ", "for", " ", "all", " ", 
         RowBox[{"deltak", ".", " ", "b"}], " ", "asymptotes", " ", "to", " ",
          "0.", "\[IndentingNewLine]", "Thus", " ", "in", " ", "the", " ", 
         "limit", " ", "we", " ", "say", " ", "that", " ", "a"}], " ", "=", 
        " ", "0"}]}]}]}], ",", " ", 
    RowBox[{
    "and", " ", "we", " ", "can", " ", "find", " ", "b", " ", "through", " ", 
     "normalization"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vinit", " ", "=", " ", 
     RowBox[{"Asymptotic", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "vk", "]"}], "^", "2"}], ",", 
       RowBox[{"\[Tau]", "->", 
        RowBox[{"-", "Infinity"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"vA", "=", " ", 
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"Asymptotic", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"vinit", "/.", 
          RowBox[{"b", "->", "0"}]}], "/.", 
         RowBox[{"a", "->", "1"}]}], ",", 
        RowBox[{"\[Tau]", "->", 
         RowBox[{"-", "Infinity"}]}]}], "]"}], ",", 
      RowBox[{"\[Tau]", "->", 
       RowBox[{"-", "Infinity"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"vB", " ", "=", " ", 
    RowBox[{"Assuming", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Tau]", "<", "0"}], "}"}], ",", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"vinit", "/.", 
         RowBox[{"b", "->", "1"}]}], "/.", 
        RowBox[{"a", "->", "0"}]}], " ", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{"vA", ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]k", ",", "0.1", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"vB", "/.", 
      RowBox[{"\[CapitalDelta]k", "->", "1"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
