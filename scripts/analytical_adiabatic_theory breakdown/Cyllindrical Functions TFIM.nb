Cell[BoxData[
 RowBox[{"2", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], 
   RowBox[{"1", "/", "4"}]], " ", 
  SqrtBox["\[CapitalDelta]k"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"ParabolicCylinderD", "[", 
      RowBox[{
       FractionBox["\[ImaginaryI]", 
        RowBox[{"4", " ", "\[CapitalDelta]k"}]], ",", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"3", "/", "4"}]]}], " ", 
        SqrtBox["\[CapitalDelta]k"], " ", "\[Tau]"}]}], "]"}]}], "-", 
    RowBox[{"b", " ", 
     RowBox[{"ParabolicCylinderD", "[", 
      RowBox[{
       FractionBox["\[ImaginaryI]", 
        RowBox[{"4", " ", "\[CapitalDelta]k"}]], ",", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"3", "/", "4"}]], " ", 
        SqrtBox["\[CapitalDelta]k"], " ", "\[Tau]"}]}], "]"}]}]}], 
