        RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "group", " ", "by", " ", "relative", " ", "structure", " ", "and", " ", 
       "count", " ", "degeneracies"}], "*)"}], 
     RowBox[{"counter", "=", 
      RowBox[{"Tally", "[", "xc", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vecs", "=", 
      RowBox[{"counter", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"counts", "=", 
      RowBox[{"counter", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"loop", " ", "over", " ", "terms"}], "*)"}], 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"relIndices", "=", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", "term", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"degen", "=", 
         RowBox[{"counts", "[", 
          RowBox[{"[", "term", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", 
           RowBox[{"Length", "[", "relIndices", "]"}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{"even", ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"dat", ",", "0"}], "]"}], ",", 
            RowBox[{
             RowBox[{"shifted", "=", 
              RowBox[{"Join", "[", 
               RowBox[{"relIndices", ",", 
                RowBox[{"relIndices", "+", 
                 RowBox[{"Floor", "[", 
                  RowBox[{"n", "/", "2"}], "]"}]}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"val", "=", 
              RowBox[{"sigmaGeneral", "[", "shifted", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"dat", ",", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"Abs", "[", "val", "]"}], "]"}], "*", "degen"}]}], 
              "]"}]}]}], "]"}], ",", 
          RowBox[{
           RowBox[{"val", "=", 
            RowBox[{"sigmaGeneral", "[", "relIndices", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"dat", ",", 
             RowBox[{"val", "*", "degen"}]}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"term", ",", 
         RowBox[{"Length", "[", "vecs", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"dat", ",", "1"}], "]"}], ";", 
     RowBox[{"(*", 
      RowBox[{"identity", " ", "contribution"}], "*)"}], 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Total", "[", "dat", "]"}], "/", 
       RowBox[{"2", "^", "n"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
