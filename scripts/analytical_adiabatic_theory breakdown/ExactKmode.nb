Cell[CellGroupData[{

Cell[BoxData["pk"], "Input",
 CellChangeTimes->{{3.9809621783590508`*^9, 3.9809623008360233`*^9}},
 CellLabel->
  "In[790]:=",ExpressionUUID->"02032804-9f5c-4b90-9a47-09efe08db801"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       FractionBox[
        RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "4"], "-", 
       RowBox[{
        FractionBox["1", "4"], " ", "\[Pi]", " ", 
        RowBox[{"Conjugate", "[", "\[Tau]", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Conjugate", "[", 
          RowBox[{"Sin", "[", "k", "]"}], "]"}], "2"]}]}]], " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{
       SqrtBox["\[Tau]"], " ", 
       RowBox[{"ParabolicCylinderD", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "\[Tau]", " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "k", "]"}], "2"]}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          SuperscriptBox["\[ExponentialE]", 
           FractionBox[
            RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "4"]], " ", 
          SqrtBox["\[Tau]"], " ", 
          RowBox[{"Cos", "[", "k", "]"}]}]}], "]"}], " ", 
       RowBox[{"Sin", "[", "k", "]"}]}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      FractionBox["k", "2"], "]"}]}], "-", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "4"]}], " ", "\[Pi]", " ", 
       RowBox[{"Conjugate", "[", "\[Tau]", "]"}], " ", 
       SuperscriptBox[
        RowBox[{"Conjugate", "[", 
         RowBox[{"Sin", "[", "k", "]"}], "]"}], "2"]}]], " ", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"ParabolicCylinderD", "[", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "\[Tau]", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "k", "]"}], "2"]}], ",", 
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          FractionBox[
           RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Pi]"}], "4"]], " ", 
         SqrtBox["\[Tau]"], " ", 
         RowBox[{"Cos", "[", "k", "]"}]}]}], "]"}], "]"}], " ", 
     RowBox[{"Sin", "[", 
      FractionBox["k", "2"], "]"}]}]}], "]"}], "2"]], "Output",
 CellChangeTimes->{{3.980962184817911*^9, 3.9809623011686363`*^9}},
 CellLabel->
  "Out[790]=",ExpressionUUID->"be92e4af-0be4-4d0a-b84b-d46e12906834"]
