Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", "definitions", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{"a", ",", "b"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "q_", "]"}], ":=", 
   RowBox[{"Sin", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", "q_", "]"}], ":=", 
    RowBox[{"1", "+", 
     RowBox[{"Cos", "[", "q", "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]", "[", "q_", "]"}], ":=", 
    RowBox[{"2", "*", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"A", "[", "q", "]"}]}], ")"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"B", "[", "q", "]"}], "^", "2"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"time", "\[Dash]", 
    RowBox[{"dependent", " ", "arguments"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"z", "[", 
     RowBox[{"q_", ",", "t_", ",", "\[Tau]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", "3", "*", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], "*", "2", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", 
        RowBox[{
         RowBox[{"A", "[", "q", "]"}], "*", "\[Tau]"}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "\[Tau]", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"u_q", 
    RowBox[{"(", "t", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"q_", ",", "t_", ",", "\[Tau]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "3", "*", 
       RowBox[{"Pi", "/", "4"}]}], "]"}], "*", 
     RowBox[{"B", "[", "q", "]"}], "*", 
     RowBox[{"Sqrt", "[", "\[Tau]", "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Pi"}], "*", 
       RowBox[{
        RowBox[{"B", "[", "q", "]"}], "^", "2"}], "*", 
       RowBox[{"\[Tau]", "/", "4"}]}], "]"}], "*", 
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"I", "*", 
         RowBox[{
          RowBox[{"B", "[", "q", "]"}], "^", "2"}], "*", "\[Tau]"}], "-", 
        "1"}], ",", 
       RowBox[{"z", "[", 
        RowBox[{"q", ",", "t", ",", "\[Tau]"}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"v_q", 
    RowBox[{"(", "t", ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", 
    RowBox[{"q_", ",", "t_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "Pi"}], "*", 
       RowBox[{
        RowBox[{"B", "[", "q", "]"}], "^", "2"}], "*", 
       RowBox[{"\[Tau]", "/", "4"}]}], "]"}]}], "*", 
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{"I", "*", 
       RowBox[{
