      RowBox[{
       RowBox[{"B", "[", "q", "]"}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"A", "[", "q", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "excited"}]}], "-", 
     RowBox[{"state", " ", "coefficient", " ", 
      RowBox[{"b_k", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bk", "[", "q_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"theta", "[", "q", "]"}], "/", "2"}], "]"}], "*", 
       RowBox[{"u", "[", "q", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{"theta", "[", "q", "]"}], "/", "2"}], "]"}], "*", 
       RowBox[{"v", "[", "q", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "excitation"}]}], " ", 
      RowBox[{"probability", "--"}]}], "-"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"bk", "[", "q", "]"}], "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"x", "/.", 
      RowBox[{"\[Tau]", "->", "0.00001"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", "0", ",", "Pi"}], "}"}]}], "]"}]}]}]], "Input",
