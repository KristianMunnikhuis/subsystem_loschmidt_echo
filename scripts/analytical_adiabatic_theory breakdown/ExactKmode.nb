Cell[BoxData[
 RowBox[{"pk", " ", "=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], "*", 
       RowBox[{"Conjugate", "[", 
