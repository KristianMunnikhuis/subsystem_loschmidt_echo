Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", 
    RowBox[{"32", " ", 
     SqrtBox["2"], " ", 
     SuperscriptBox["\[Pi]", "2"], " ", 
     SuperscriptBox["\[Tau]", 
      RowBox[{"3", "/", "2"}]]}]]}], "+", 
  FractionBox["1", 
