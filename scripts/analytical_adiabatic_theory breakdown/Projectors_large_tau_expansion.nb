Cell[BoxData[
 FractionBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SqrtBox["2"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"8", " ", "\[Pi]", " ", "\[Tau]"}]]}]]}], 
    SqrtBox["\[Tau]"]], "+", 
   RowBox[{"2", " ", 
    SqrtBox["\[Pi]"], " ", 
    RowBox[{"Re", "[", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[Pi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"Log", "[", "\[Tau]", "]"}]}], "-", 
           RowBox[{"8", " ", "\[ImaginaryI]", " ", 
            SuperscriptBox["\[Tau]", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Log", "[", "\[Tau]", "]"}], "2"]}]}], 
          RowBox[{"4", " ", "\[Tau]", " ", 
           SuperscriptBox[
            RowBox[{"Log", "[", "\[Tau]", "]"}], "2"]}]]}]], " ", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox["\[Pi]", 
            RowBox[{"4", " ", "\[Tau]", " ", 
             SuperscriptBox[
              RowBox[{"Log", "[", "\[Tau]", "]"}], "2"]}]]}]]}]]}], 
      SqrtBox[
       RowBox[{"\[Tau]", " ", 
        RowBox[{"Log", "[", "\[Tau]", "]"}]}]]], "]"}]}]}], 
  RowBox[{"8", " ", "\[Pi]"}]]], "Output",
