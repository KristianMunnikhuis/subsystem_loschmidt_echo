          RowBox[{"n", "-", "1"}]}], "]"}], ",", "sz", ",", 
        RowBox[{"Mod", "[", 
         RowBox[{"j", ",", "n", ",", "1"}], "]"}]}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sPlus", "[", 
      RowBox[{"n_", ",", "j_"}], "]"}], ":=", 
